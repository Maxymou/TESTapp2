# PWA Test Lab runtime configuration
APP_PORT=8080
APP_VERSION=0.1.0
NODE_ENV=production

# Token entered in the DEV page and checked by the backend.
DEV_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Shared backend -> host API token. Do not expose it in the browser.
DEV_ALLOWED_TOKEN=replace-with-a-different-long-random-host-token
DEV_HOST_API_URL=http://host.docker.internal:4878
DEV_REQUEST_TIMEOUT_MS=120000

# Host API service configuration (used by systemd EnvironmentFile if desired).
HOST_API_PORT=4878
PWA_TEST_LAB_WORKDIR=/opt/PWA-Test-Lab
HOST_COMMAND_TIMEOUT_MS=180000
