# TESTapp2 runtime configuration
APP_PORT=3000
APP_VERSION=0.1.0
DOCKER_PROJECT_NAME=testapp2
FRONTEND_CONTAINER=testapp2-frontend
BACKEND_CONTAINER=testapp2-backend
APP_WORKDIR=/opt/TESTapp2
NODE_ENV=production

# Token entered in the DEV page and checked by the backend.
DEV_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Shared backend -> host API token. Do not expose it in the browser.
DEV_ALLOWED_TOKEN=replace-with-a-different-long-random-host-token
DEV_HOST_API_URL=http://host.docker.internal:4878
DEV_REQUEST_TIMEOUT_MS=120000

# Authentification applicative (changez ces valeurs avant toute exposition réseau).
USER_DATA_PATH=/data/users.json
SESSION_SECRET=replace-with-a-very-long-random-session-secret
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=testapp2_session
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=Administrateur

# Host API service configuration (used by systemd EnvironmentFile if desired).
HOST_API_PORT=4878
HOST_COMMAND_TIMEOUT_MS=180000

# Deprecated fallback kept for old Host API service files. Prefer APP_WORKDIR.
PWA_TEST_LAB_WORKDIR=/opt/TESTapp2
