[Unit]
Description=TESTapp2 DEV Host API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/TESTapp2
Environment=NODE_ENV=production
Environment=HOST_API_PORT=4878
Environment=APP_WORKDIR=/opt/TESTapp2
EnvironmentFile=-/opt/TESTapp2/.env
ExecStart=/usr/bin/node /opt/TESTapp2/host-tools/dev-host-api.js
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
